{
  "language": "japanese",
  "permissions": {
    "allow": [
      "Bash(pkill*)",
      "Bash(sleep*)",
      "Bash(cd *)",
      "Bash(./gradlew*)",
      "Bash(npm*)",
      "Bash(curl*)",
      "Bash(tail*)",
      "Bash(grep*)",
      "Bash(echo*)",
      "Bash(cat*)",
      "Bash(ls*)",
      "Bash(find*)",
      "Bash(mv*)",
      "Bash(rm -rf build*)",
      "Bash(rm -rf node_modules*)"
    ],
    "ask": [
      "Bash(rm*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(./gradlew bootRun)",
            "command": ".claude/port-cleanup.sh 8080",
            "statusMessage": "ポート 8080 を確認・クリア中...",
            "timeout": 10
          },
          {
            "type": "command",
            "if": "Bash(npm run dev)",
            "command": ".claude/port-cleanup.sh 5173",
            "statusMessage": "ポート 5173 を確認・クリア中...",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
